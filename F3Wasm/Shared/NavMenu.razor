@using F3Core.Regions

<header class="site-header">
    <div class="site-header-inner">
        <div class="site-mark" aria-hidden="true">F3</div>
        <div class="site-title">@MenuTitle</div>
        @if (!string.IsNullOrWhiteSpace(Region))
        {
            <a href="@($"/chat/{Region}")" style="margin-left:auto;color:inherit;font-size:.9rem;text-decoration:none">Ask @RegionDisplayName ↗</a>
        }
    </div>
</header>

@code {
    [Parameter]
    public string? Region { get; set; }

    private string RegionDisplayName => RegionList.All.FirstOrDefault(r => r.QueryStringValue.Equals(Region, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? Region ?? "";

    private string MenuTitle { get; set; } = "F3 Tools";

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Region))
            return;

        var regionInfo = RegionList.All.FirstOrDefault(item =>
            string.Equals(item.QueryStringValue, Region, StringComparison.OrdinalIgnoreCase));
        var display = regionInfo?.DisplayName ?? Region;

        if (!display.Contains("FiA") && display != "F3 Tools")
            display = "F3 " + display;

        MenuTitle = display;
    }
}
