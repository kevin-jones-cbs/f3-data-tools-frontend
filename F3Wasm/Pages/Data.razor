@page "/data/{region}"
@using F3Wasm.Components
@using F3Wasm.Components.Challenges
@using F3Wasm.Models
@using F3Wasm.Data
@using F3Core
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>F3 @Region.ToUpper() Data</PageTitle>

<style>
    /* Hide the date picker box in the modal */
    .pax-details-calendar .form-control {
        display: none;
    }

    /* Disabled Dates should have a different style */
    .flatpickr-day.flatpickr-disabled {
        background: #28a745;
        color: #fff;
    }

    /* Center the date picker */
    .flatpickr-calendar {
        margin: auto;
    }

    .dot {
        height: 8px;
        width: 8px;
        background-color: #bbb;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
    }

    .link {
        color: #007bff;
        text-decoration: none;
        background-color: transparent;
        cursor: pointer;
    }

    #privacy-note {
        margin-top: 12px;
        font-size: 10px;
        text-align: center;
    }

    #historical-note {
        margin-top: 12px;
        font-style: italic;
    }

    #loader {
        display: flex;
        justify-content: center;
    }

    .center-content {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
    }

    .aoChallengeButton {
        height: 75px;
    }

    .aoChallengeContainer {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .hyperlink {
        color: #4A90E2;
    }

    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loading-overlay-content {
        background-color: white;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .loading-overlay-text {
        margin-top: 15px;
        font-size: 16px;
        font-weight: 500;
        color: #333;
    }

    .pax-details {
        max-width: 1480px;
        margin: 0 auto;
    }

    .pax-details-grid {
        display: grid;
        grid-template-columns: minmax(320px, 2fr) minmax(480px, 3fr);
        gap: 1rem;
        margin-top: 1rem;
        align-items: start;
    }

    .pax-details-panel {
        min-width: 0;
        padding: 1rem;
        border: 1px solid #dee2e6;
        border-radius: .5rem;
        background: #fff;
        box-shadow: 0 .125rem .25rem rgba(0, 0, 0, .045);
    }

    .pax-details-panel-title {
        margin: 0 0 .75rem;
        font-size: 1rem;
        font-weight: 600;
    }

    .pax-details-calendar .flatpickr-calendar {
        box-shadow: none;
    }

    .pax-details-locations .pax-locations-scroll {
        max-height: 28rem;
        overflow: auto;
    }

    .pax-details-locations table {
        margin-bottom: 0;
    }

    .pax-details-locations thead {
        position: sticky;
        top: 0;
        z-index: 1;
        background: #fff;
    }

    .pax-details-secondary {
        margin-top: 1rem;
    }

    @@media (min-width: 992px) {
        #SelectedPaxModal .pax-details-modal {
            width: calc(100vw - 3rem);
            max-width: 1560px;
            height: calc(100vh - 3rem);
            margin: 1.5rem auto;
        }

        #SelectedPaxModal .pax-details-modal .modal-content {
            height: 100%;
            border-radius: .6rem;
            overflow: hidden;
        }

        #SelectedPaxModal .modal-header,
        #SelectedPaxModal .modal-footer {
            flex: 0 0 auto;
        }

        #SelectedPaxModal .modal-body {
            overflow-y: auto;
            padding: 1.25rem 1.5rem;
        }
    }

    @@media (max-width: 991.98px) {
        .pax-details-grid {
            grid-template-columns: 1fr;
        }

        .pax-details-panel {
            padding: .75rem;
        }
    }
</style>

@if (currentRows == null)
{
    <div class="page-loading" role="status">
        <SpinKit Type="SpinKitType.Bounce" />
        <span>Loading activity…</span>
    </div>
}
else
{
    <section class="data-heading">
        <div>
            <p class="data-eyebrow">@RegionInfo.DisplayName</p>
            <h1>Activity</h1>
            <p class="data-subtitle">Regional leaderboard and participation trends.</p>
        </div>
        @if (lastUpdatedDate != DateTime.MinValue)
        {
            <div class="updated-status">
                <span class="status-dot"></span>
                Updated @lastUpdatedDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
            </div>
        }
    </section>

    <section class="view-controls" aria-label="Activity view controls">
        <div class="report-tabs" role="tablist" aria-label="Reports">
            <button type="button" role="tab" class="report-tab @(IsLeaderboardView ? "active" : null)" aria-selected="@IsLeaderboardView" @onclick="ShowAllTime">Leaderboard</button>
            <button type="button" role="tab" class="report-tab @(currentView == OverallView.Kotter ? "active" : null)" aria-selected="@(currentView == OverallView.Kotter)" @onclick="ShowKotter">Kotter</button>
            <button type="button" role="tab" class="report-tab @(currentView == OverallView.QKotter ? "active" : null)" aria-selected="@(currentView == OverallView.QKotter)" @onclick="ShowQKotter">Q Kotter</button>
            @if (RegionInfo.HasQSourcePosts)
            {
                <button type="button" role="tab" class="report-tab @(currentView == OverallView.QSource ? "active" : null)" aria-selected="@(currentView == OverallView.QSource)" @onclick="ShowQSource">Q Source</button>
            }
            @if (RegionInfo.DisplayName != "Gold Rush")
            {
                <button type="button" role="tab" class="report-tab @(currentView == OverallView.AoList ? "active" : null)" aria-selected="@(currentView == OverallView.AoList)" @onclick="ShowAoList">@DateTime.Now.ToString("MMM", CultureInfo.InvariantCulture) AOs</button>
            }
        </div>

        @if (IsLeaderboardView && validYears != null)
        {
            <div class="period-controls" aria-label="Time period">
                <button type="button" class="period-button @(currentView == OverallView.AllTime ? "active" : null)" @onclick="ShowAllTime">All time</button>
                <Dropdown @ref="yearDropdown" Display="Display.InlineBlock" Class="period-dropdown">
                    <DropdownToggle Color="Color.Light">@(currentView == OverallView.Year || currentView == OverallView.Month ? currentYear : "Year")</DropdownToggle>
                    <DropdownMenu MaxMenuHeight="180px">
                        @foreach (var year in validYears)
                        {
                            <DropdownItem Clicked="@(() => ShowYear(year))">@year</DropdownItem>
                        }
                    </DropdownMenu>
                </Dropdown>
                <Dropdown @ref="monthDropdown" Display="Display.InlineBlock" Class="period-dropdown">
                    <DropdownToggle Color="Color.Light">@(currentView == OverallView.Month ? currentMonth : "Month")</DropdownToggle>
                    <DropdownMenu MaxMenuHeight="240px">
                        @foreach (var month in validMonths)
                        {
                            <DropdownItem Clicked="@(() => ShowMonth(month))">@month</DropdownItem>
                        }
                    </DropdownMenu>
                </Dropdown>
            </div>
        }
    </section>

    @if (RegionInfo.DisplayName == "Gold Rush")
    {
        <button type="button" class="challenge-card @(currentView == OverallView.GoldStandard ? "active" : null)" @onclick="ShowGoldStandard"><span><small>Featured challenge</small><strong>Gold Standard</strong></span><span class="challenge-arrow">View →</span></button>
    }
    else if (RegionInfo.DisplayName == "Terracotta")
    {
        <button type="button" class="challenge-card @(currentView == OverallView.TerracottaChallenge ? "active" : null)" @onclick="ShowTerracottaChallenge"><span><small>Featured challenge</small><strong>Forged in Fire 2026</strong></span><span class="challenge-arrow">View →</span></button>
    }
    else if (RegionInfo.DisplayName == "South Fork")
    {
        <button type="button" class="challenge-card @(currentView == OverallView.SouthForkChallenge ? "active" : null)" @onclick="ShowSouthForkChallenge"><span><small>Featured challenge</small><strong>High Water Mark</strong></span><span class="challenge-arrow">View →</span></button>
    }
    else if (RegionInfo.DisplayName == "Mother Lode")
    {
        <button type="button" class="challenge-card @(currentView == OverallView.ForgeChallenge ? "active" : null)" @onclick="ShowForgeChallenge"><span><small>Featured challenge</small><strong>The Forge Challenge</strong></span><span class="challenge-arrow">View →</span></button>
    }
    else if (RegionInfo.DisplayName == "SacTown")
    {
        <button type="button" class="challenge-card @(currentView == OverallView.TowerChallenge ? "active" : null)" @onclick="ShowTowerChallenge"><span><small>Featured challenge</small><strong>The Tower Challenge</strong></span><span class="challenge-arrow">View →</span></button>
    }

    @if (loading)
    {
        <div id="loader"><SpinKit Type="SpinKitType.Bounce" /></div>
    }
    else
    {
        var mobileRows = GetMobileRows().ToList();
        <section class="results-toolbar" aria-label="Results tools">
            <div class="results-heading">
                <h2>@CurrentViewTitle</h2>
                @if (!IsChallengeView)
                {
                    <span>@mobileRows.Count @(mobileRows.Count == 1 ? "PAX" : "PAX")</span>
                }
            </div>
            <div class="results-actions">
                <label class="search-box">
                    <span class="sr-only">Search PAX</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m21 21-4.35-4.35m2.35-5.15a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" /></svg>
                    <input type="search" value="@customFilterValue" @oninput="OnSearchInput" placeholder="Search PAX…" />
                </label>
                @if (!IsChallengeView)
                {
                    <label class="mobile-sort">
                        <span>Sort</span>
                        <select value="@mobileSort" @onchange="OnMobileSortChanged">
                            <option value="default">Recommended</option>
                            <option value="name">Name A–Z</option>
                            <option value="posts">Most posts</option>
                            <option value="qs">Most Qs</option>
                            @if (currentView == OverallView.AllTime || currentView == OverallView.Year || currentView == OverallView.Month)
                            {
                                <option value="heat">Hottest recently</option>
                                <option value="rate">Highest post rate</option>
                                <option value="streak">Longest streak</option>
                            }
                            @if (currentView == OverallView.Kotter || currentView == OverallView.QKotter)
                            {
                                <option value="days">Most days away</option>
                            }
                            @if (currentView == OverallView.AoList || currentView == OverallView.AoChallenge)
                            {
                                <option value="aos">Most AOs</option>
                            }
                        </select>
                    </label>
                }
                @if (currentView == OverallView.Kotter || currentView == OverallView.QKotter)
                {
                    <button type="button" class="export-button" @onclick="ExportToCsv">Export CSV</button>
                }
            </div>
        </section>

        @if (currentView == OverallView.GoldStandard && allData != null)
        {
            <GoldStandard AllData="allData" FilterValue="@customFilterValue"></GoldStandard>
        }
        else if (currentView == OverallView.TerracottaChallenge && allData != null)
        {
            <PaxOnFire AllData="allData" FilterValue="@customFilterValue" RegionInfo="@RegionInfo"></PaxOnFire>
        }
        else if (currentView == OverallView.SouthForkChallenge)
        {
            <HighWaterMark AllData="allData" FilterValue="@customFilterValue" RegionInfo="@RegionInfo"></HighWaterMark>
        }
        else if (currentView == OverallView.ForgeChallenge && allData != null)
        {
            <Forge AllData="allData" FilterValue="@customFilterValue" RegionInfo="@RegionInfo"></Forge>
        }
        else if (currentView == OverallView.TowerChallenge && allData != null)
        {
            <Tower AllData="allData" FilterValue="@customFilterValue" RegionInfo="@RegionInfo"></Tower>
        }
        else
        {
            <div class="desktop-results">
                <DataGrid @ref="dataGrid"
                    TItem="DisplayRow"
                    Data="@currentRows"
                    ShowPager
                    CustomFilter="@OnCustomFilter"
                    SortMode="DataGridSortMode.Single"
                    PageSize="50"
                    Narrow
                    ShowPageSizes
                    PagerOptions="new(){ ButtonRowPosition=PagerElementPosition.Start }"
                    SelectedRowChanged="SelectedRowChanged"
                    Class="leaderboard-grid"
                    Responsive>
                <DataGridColumns>
                <DataGridColumn Field="@nameof(DisplayRow.PaxName)" Caption="Name" SortField="@nameof(DisplayRow.PaxName)">
                     <DisplayTemplate > 
                        <span class="hyperlink">@context.PaxName</span>
                    </DisplayTemplate> 
                </DataGridColumn>

                @if (IsLeaderboardView)
                {
                    <DataGridColumn Field="@nameof(DisplayRow.RecentPostCount)" Caption="30d Heat" SortField="@nameof(DisplayRow.RecentPostCount)" Filterable="false">
                        <DisplayTemplate>
                            <HeatIndicator Row="@context" RegionName="@RegionInfo.DisplayName" ShowCount />
                        </DisplayTemplate>
                    </DataGridColumn>
                }

                @if (currentView != OverallView.AoChallenge && currentView != OverallView.AoList)
                {
                    <DataGridColumn Field="@nameof(DisplayRow.PostCount)" Caption="Posts" Filterable="false" />
                    <DataGridColumn Field="@nameof(DisplayRow.QCount)" Caption="Q" Filterable="false" />
                }

                @if (currentView == OverallView.Kotter)
                {
                    <DataGridColumn Field="@nameof(DisplayRow.LastPost)" Caption="Last Post" Filterable="false" DisplayFormat="{0:M/d/yy}" />
                    <DataGridColumn Field="@nameof(DisplayRow.KotterDays)" Caption="Days Since" Filterable="false" />
                }
                else @if (currentView == OverallView.QKotter)
                {
                    <DataGridColumn Field="@nameof(DisplayRow.LastQ)" Caption="Last Q" Filterable="false" DisplayFormat="{0:M/d/yy}" />
                    <DataGridColumn Field="@nameof(DisplayRow.LastPost)" Caption="Last Post" Filterable="false" DisplayFormat="{0:M/d/yy}" />
                    <DataGridColumn Field="@nameof(DisplayRow.KotterDays)" Caption="Days Since" Filterable="false" />
                }
                else if (currentView == OverallView.AoChallenge || currentView == OverallView.AoList)
                {
                    <DataGridColumn Field="@nameof(DisplayRow.PostCount)" Caption="Posts" Filterable="false" />
                    <DataGridColumn Field="@nameof(DisplayRow.AoPosts)" Caption="AOs Posted" Filterable="false" />
                    <DataGridColumn Field="@nameof(DisplayRow.AoPercent)" Caption="AO Percent" Filterable="false" DisplayFormat="{0:0}%" />
                }
                else if (currentView == OverallView.QSource)
                {
                    @* Empty except posts/Q above *@
                }
                else
                {
                    <DataGridColumn Field="@nameof(DisplayRow.FirstPost)" Caption="1st Post" Filterable="false" DisplayFormat="{0:M/d/yy}" />
                    <DataGridColumn Field="@nameof(DisplayRow.PostPercent)" Caption="@(RegionInfo.HasHistoricalData && currentView == OverallView.AllTime ? "Post % *" : "Post %")" Filterable="false" DisplayFormat="{0:0}%" />
                    <DataGridColumn Field="@nameof(DisplayRow.Streak)" Caption="@(RegionInfo.HasHistoricalData && currentView == OverallView.AllTime ? "Daily Streak *" : "Daily Streak")" Filterable="false" />
                    <DataGridColumn Field="@nameof(DisplayRow.QRatio)" Caption="Q Ratio" Filterable="true" DisplayFormat="{0:0}%" />

                    @if (RegionInfo.HasExtraActivity)
                    {
                        <DataGridColumn Field="@nameof(DisplayRow.ExtraActivityCount)" Caption="Pre Workouts" Filterable="false" />
                    }
                }
                </DataGridColumns>
                </DataGrid>
            </div>

            <div class="mobile-results" aria-label="PAX results">
                @for (var i = 0; i < Math.Min(mobileRowsVisible, mobileRows.Count); i++)
                {
                    var row = mobileRows[i];
                    <button type="button" class="mobile-result-row" @onclick="(() => SelectedRowChanged(row))">
                        <span class="mobile-rank">@(i + 1)</span>
                        <span class="mobile-result-content">
                            <strong>
                                <span>@row.PaxName</span>
                                @if (IsLeaderboardView)
                                {
                                    <HeatIndicator Row="@row" RegionName="@RegionInfo.DisplayName" ShowCount />
                                }
                            </strong>
                            @if (currentView == OverallView.Kotter)
                            {
                                <span>@row.PostCount.ToString("N0") posts · Last posted @row.LastPost?.ToString("M/d/yy")</span>
                                <span class="mobile-metric"><b>@row.KotterDays</b> days away</span>
                            }
                            else if (currentView == OverallView.QKotter)
                            {
                                <span>@row.QCount.ToString("N0") Qs · Last Q @row.LastQ?.ToString("M/d/yy")</span>
                                <span class="mobile-metric"><b>@row.KotterDays</b> days since Q</span>
                            }
                            else if (currentView == OverallView.AoList || currentView == OverallView.AoChallenge)
                            {
                                <span>@row.PostCount.ToString("N0") posts · @row.AoPosts AOs visited</span>
                                <span class="mobile-metric"><b>@row.AoPercent.ToString("0")%</b> AO coverage</span>
                            }
                            else if (currentView == OverallView.QSource)
                            {
                                <span>@row.PostCount.ToString("N0") posts</span>
                                <span class="mobile-metric"><b>@row.QCount</b> Qs</span>
                            }
                            else
                            {
                                <span>@row.PostCount.ToString("N0") posts · @row.QCount Qs</span>
                                <span class="mobile-metric"><b>@row.PostPercent.ToString("0")%</b> post rate · <b>@row.Streak</b> streak</span>
                            }
                        </span>
                        <span class="mobile-chevron" aria-hidden="true">›</span>
                    </button>
                }
                @if (mobileRows.Count > mobileRowsVisible)
                {
                    <button type="button" class="show-more" @onclick="ShowMoreMobileRows">Show 50 more</button>
                }
            </div>
        }

        @if (RegionInfo.HasHistoricalData && firstNonHistoricalDate.HasValue)
        {
            <p class="historical-footnote">* Since @firstNonHistoricalDate.Value.ToString("M/d/yy")</p>
        }
    }
    <Modal @bind-Visible="@showPaxModal" id="SelectedPaxModal" Closing="@OnModalClosing">
        @if (selectedPax != null && allData != null)
        {
            <ModalContent Centered Size="ModalSize.Fullscreen" Class="pax-details-modal">
                 <ModalHeader>
                     <ModalTitle>@selectedPax.Name</ModalTitle>
                     <CloseButton />
                 </ModalHeader>
                 <ModalBody>
                     <div class="pax-details">
                         <PaxSummaryTable
                             RegionInfo="@RegionInfo"
                             SelectedPaxPosts="@selectedPaxPosts"
                             AllPosts="@allData.Posts"
                             AllPossibleWorkoutDays="@allPossibleWorkoutDays"
                             SelectedPaxHistoricalData="@selectedPaxHistoricalData"
                         />

                         <div class="pax-details-grid">
                             <section class="pax-details-panel pax-details-calendar">
                                 <h2 class="pax-details-panel-title">Activity calendar</h2>
                                 <PaxCalendar
                                     SelectedPaxPosts="@selectedPaxPosts"
                                     SelectedPaxQSourcePosts="@selectedPaxQSourcePosts"
                                     HasQSource="RegionInfo.HasQSourcePosts"
                                 />
                             </section>

                             <section class="pax-details-panel pax-details-locations">
                                 <h2 class="pax-details-panel-title">Posts by location</h2>
                                 <PaxLocations
                                     RegionInfo="@RegionInfo"
                                     SelectedPaxPosts="@selectedPaxPosts"
                                     AoList="@allData.Aos"
                                     HasHistoricalData="selectedPaxHistoricalData != null"
                                 />
                             </section>
                         </div>

                         @if (!RegionInfo.HasHistoricalData)
                         {
                             <div class="pax-details-secondary">
                                 <PaxMilestoneChart
                                     SelectedPaxPosts="@selectedPaxPosts"
                                     SelectedPaxHistoricalData="@selectedPaxHistoricalData"
                                     AllPossibleWorkoutDays="@allPossibleWorkoutDays"
                                 />
                             </div>
                         }

                         <div class="pax-details-panel pax-details-secondary">
                             <PaxPostedWith
                                 AllPosts="@allData.Posts"
                                 RegionInfo="@RegionInfo"
                                 SelectedPaxPosts="@selectedPaxPosts"
                                 SelectedPaxHistoricalData="@selectedPaxHistoricalData"
                             />
                         </div>

                         @if (selectedPaxHistoricalData != null)
                         {
                             <Row>
                                 <Column id="historical-note">
                                     * Since @firstNonHistoricalDate.Value.ToString("M/d/yy")
                                 </Column>
                             </Row>
                         }

                         <Row>
                             <Column id="privacy-note">
                                 If you see any errors, or would like to hide your data, contact Peacock or a Band admin.
                             </Column>
                         </Row>
                     </div>
                 </ModalBody>
                 <ModalFooter>
                     <Button Color="Color.Secondary" Clicked="@HideModal">Close</Button>
                 </ModalFooter>
             </ModalContent>
         }
     </Modal>

     @if (allData != null)
     {
         <AoChallengeModal
             @bind-Visible="showAoChallengeModal"
             SelectedPax="selectedPax"
             SelectedPaxPosts="selectedPaxPosts"
             Aos="allData.Aos"
             RegionInfo="RegionInfo"
             CurrentView="currentView"
         />
     }

     @if (loadingFullData)
     {
         <div class="loading-overlay">
             <div class="loading-overlay-content">
                 <SpinKit Type="SpinKitType.Bounce" />
                 <div class="loading-overlay-text">Loading all data...</div>
             </div>
         </div>
     }
}
