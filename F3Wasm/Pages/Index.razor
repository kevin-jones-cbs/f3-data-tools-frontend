@page "/upload/{region}"
@using F3Wasm.Models
@using F3Wasm.Data
@using F3Core.Regions
@inject HttpClient Http

<PageTitle>F3 @Region.ToUpper() Importer</PageTitle>

<div class="upload-page">
<header class="upload-heading">
    <div>
        <span class="eyebrow">Data administration</span>
        <h1>Workout upload</h1>
        <p>@(string.IsNullOrWhiteSpace(RegionInfo?.DisplayName) ? "Post attendance and keep the regional data set current." : $"Post attendance for {RegionInfo.DisplayName} and keep the regional data set current.")</p>
    </div>
    @if (aoList != null)
    {
        <div class="heading-actions" aria-label="Data maintenance actions">
            <Button Color="Color.Secondary" Outline Clicked="OnMissingAoButtonClicked" Loading="isMissingDataLoading">
                Check missing
            </Button>
            <Button Color="Color.Secondary" Outline Clicked="ClearCache" Loading="isCacheClearing">
                Clear cache
            </Button>
        </div>
    }
</header>

@if (aoList == null)
{
    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="load-error" role="alert">
            <span class="error-icon" aria-hidden="true">!</span>
            <div><strong>Upload tools couldn’t be loaded</strong><p>@loadError</p><Button Color="Color.Danger" Outline Clicked="LoadUploadDataAsync">Try again</Button></div>
        </div>
    }
    else
    {
        <div class="upload-loading" role="status" aria-live="polite">
            <span class="upload-spinner" aria-hidden="true"></span>
            <div><strong>Loading upload tools</strong><span>Fetching locations and recent workout data…</span></div>
        </div>
    }
}
else
{
    @if (!string.IsNullOrWhiteSpace(maintenanceMessage))
    {
        <div class="maintenance-message @(maintenanceMessageIsError ? "error" : "success")" role="status"><span aria-hidden="true">@(maintenanceMessageIsError ? "!" : "✓")</span>@maintenanceMessage</div>
    }
    <div class="upload-layout">
        <main class="upload-workflow">
        <section class="upload-card">
            <div class="step-heading">
                <span class="step-number">1</span>
                <div><h2>Workout details</h2><p>Choose the date and AO for this entry.</p></div>
            </div>

            <label class="field-label">Workout date</label>
            <div class="date-control">
                <Addons>
                    <Addon AddonType="AddonType.Body">
                        <DatePicker @ref="@datePicker" TValue="DateTime?" Placeholder="Q Date" Date="@qDate" DateChanged="@OnDateChanged" DisplayFormat="MMM d, yyyy" />
                    </Addon>
                    <Addon AddonType="AddonType.End">
                        <Button Color="Color.Secondary" Clicked="@(()=>datePicker.ToggleAsync())" aria-label="Open date picker">
                            <Icon Name="IconName.CalendarDay" />
                        </Button>
                    </Addon>
                </Addons>
            </div>

            <div class="field-heading">
                <label class="field-label">Location</label>
                <span>@qDate?.DayOfWeek</span>
            </div>
            <div class="location-grid">
                @foreach (var item in aoList)
                {
                    <div style="@ShowOrHideAo(item)">
                        <button type="button" class="@GetLocationCardClass(item)" @onclick="@(() => OnAoChanged(item.Name))" aria-pressed="@(ao == item.Name)">
                            <span class="location-copy"><strong>@item.Name</strong><small>@item.City</small></span>
                            <span class="@GetIndicatorClass(item)" aria-hidden="true">
                                @if (ao == item.Name) { <span class="dot"></span> }
                            </span>
                        </button>
                    </div>
                }
            </div>

            @if (ao == AoOtherValue)
            {
                <div class="other-location">
                    <label class="field-label">Location name</label>
                    <TextEdit @bind-Text="@otherAoName" Placeholder="Full Moon Ruck, etc."></TextEdit>
                </div>
            }

            <div class="workout-options">
                @if (RegionInfo.HasQSourcePosts)
                {
                    <label><Check TValue="bool" @bind-Checked="@isQSource" /><span><strong>Q Source</strong><small>Record this as a Q Source post</small></span></label>
                }
                <label><Check TValue="bool" @bind-Checked="@isSiteClosed" /><span><strong>Site closed</strong><small>Record a closure without attendance</small></span></label>
            </div>
        </section>

        <section class="upload-card">
            <div class="step-heading">
                <span class="step-number">2</span>
                <div><h2>@(isSiteClosed ? "Confirm closure" : "Add attendance")</h2><p>@(isSiteClosed ? "This prevents the workout from appearing as missing." : "Paste the backblast attendance comment, then review its matches.")</p></div>
            </div>

            @if (!isSiteClosed)
            {
                <div class="comment-field">
                    <label class="field-label">PAX comment</label>
                    <MemoEdit Rows="6" @bind-Text="@comment" Placeholder="Paste the PAX comment here…" />
                    <small>Names will be matched against the current regional roster.</small>
                </div>
                <Button Color="Color.Primary" Clicked="OnCommentButtonClicked" Class="primary-action" Loading="commentIsLoading" Disabled="@string.IsNullOrWhiteSpace(comment)">
                    Match PAX <span aria-hidden="true">→</span>
                </Button>
            }
            else
            {
                <div class="closure-note"><Icon Name="IconName.InfoCircle" /><span>This adds a “Site Closed” row to the data sheet for the selected date and location.</span></div>
                <Button Color="Color.Primary" Clicked="OnSiteClosedClicked" Class="primary-action" Disabled="@string.IsNullOrWhiteSpace(ao)">Record site closure</Button>
            }
        </section>
        </main>

        <aside class="missing-panel">
            <div class="aside-heading">
                <div><span class="eyebrow">Data health</span><h2>Missing workouts</h2></div>
                @if (missingDates.Count > 0) { <span class="count-badge">@missingDates.Count</span> }
            </div>
        @if (missingDates.Count > 0)
        {
            <p class="aside-intro">Select an entry to prefill its date and location.</p>
            <div class="missing-list">
                @foreach (var date in missingDates.OrderBy(d => d))
                {
                    <section class="missing-date">
                        <h3><span>@date.ToString("ddd")</span>@date.ToString("MMM d, yyyy")</h3>
                        <div class="missing-dates-grid">
                            @foreach (var missingAo in missingAos.Where(x => x.Date.Date == date.Date))
                            {
                                <button type="button" class="missing-entry" @onclick="@(() => OnMissingAoSelected(missingAo, false))"><span>@missingAo.Name</span><span aria-hidden="true">→</span></button>
                            }
                            @foreach (var qSourceAo in missingQSourceAos.Where(x => x.Date.Date == date.Date))
                            {
                                <button type="button" class="missing-entry qsource" @onclick="@(() => OnMissingAoSelected(qSourceAo, true))"><span>@qSourceAo.Name <small>QS</small></span><span aria-hidden="true">→</span></button>
                            }
                        </div>
                    </section>
                }
            </div>
        }
        else if (showNoMissingAoMessage)
        {
            <div class="all-current"><span aria-hidden="true">✓</span><div><strong>All up to date</strong><p>No expected workouts are missing.</p></div></div>
        }
        else
        {
            <div class="aside-loading"><span class="upload-spinner" aria-hidden="true"></span><span>Checking recent workouts…</span></div>
        }
        </aside>
    </div>
    @if (!string.IsNullOrEmpty(errorMessage) && (pax.Count == 0 || isSiteClosed))
    {
        <div class="upload-alert error standalone" role="alert"><span aria-hidden="true">!</span><div><strong>Action needed</strong><p>@errorMessage</p></div></div>
    }
}
@if (pax.Count > 0 && !isSiteClosed)
{
    <section class="upload-card review-card">
        <div class="review-heading">
            <div class="step-heading">
                <span class="step-number">3</span>
                <div><h2>Review matches</h2><p>Confirm names and identify the Q or any FNGs before uploading.</p></div>
            </div>
            <span class="pax-count">@pax.Count PAX</span>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="upload-alert error" role="alert"><span aria-hidden="true">!</span><div><strong>Fix the highlighted details</strong><p>@errorMessage</p></div></div>
        }

        <div class="review-table">
        <Table Narrow>
        <TableHeader>
            <TableRow>
                <TableHeaderCell>Name</TableHeaderCell>
                <TableHeaderCell>Q</TableHeaderCell>
                <TableHeaderCell>FNG</TableHeaderCell>
                @if (RegionInfo.HasExtraActivity)
                {
                    <TableHeaderCell><span class="desktop-label">Pre-workout</span><span class="mobile-label">Pre</span></TableHeaderCell>
                }
                <TableHeaderCell><span class="sr-only">Actions</span></TableHeaderCell>
            </TableRow>
        </TableHeader>
        <TableBody>
            @foreach (var p in pax.Where(x => x.IsOfficial).ToList())
            {
                <TableRow @key="@p" Color="@(p.IsQ ? Color.Primary : Color.Default)">
                    <TableRowCell>
                        @p.Name
                    </TableRowCell>
                    <TableRowCell>
                        <Check TValue="bool" Checked="@p.IsQ" CheckedChanged="@(isChecked => OnQSelected(p, (bool)isChecked))">
                        </Check>
                    </TableRowCell>
                    <TableRowCell>
                        <Check TValue="bool" Disabled></Check>
                    </TableRowCell>
                    @if (RegionInfo.HasExtraActivity)
                    {
                        <TableRowCell>
                            <Check TValue="bool" @bind-Checked="@p.ExtraActivity"></Check>
                        </TableRowCell>
                    }
                    <TableRowCell>
                        <button type="button" class="remove-pax" @onclick="@(() => OnRemovePax(p))" aria-label="Remove @p.Name" title="Remove PAX"><Icon Name="IconName.Times" /></button>
                    </TableRowCell>
                </TableRow>
            }

            @foreach (var p in pax.Where(x => !x.IsOfficial).ToList())
            {
                <TableRow @key="@p" Color="@(string.IsNullOrEmpty(p.Name) ? Color.Danger : p.IsFng ? Color.Success : Color.Default)">
                    <TableRowCell>
                        @if (p.IsFng)
                        {
                            <TextEdit @bind-Text="@p.Name"></TextEdit>
                            <div class="downrange-toggle"><Check TValue="bool" @bind-Checked="@p.IsDr">Downrange?</Check></div>
                            @if (p.IsDr)
                            {
                                <div class="downrange-help">Downrange adds this PAX to the roster with the selected naming region without marking them as an FNG.</div>
                                <Select TValue="int" @bind-SelectedValue="@p.NamingRegionIndex">
                                    <SelectItem Value="0">Select a Naming Region</SelectItem>
                                    @foreach (var region in downrangeNamingRegions)
                                    {
                                        <SelectItem Value="@region.Index">@region.DisplayName</SelectItem>
                                    }
                                </Select>
                            }
                        }
                        else
                        {
                            <Autocomplete TItem="String" TValue="string" Data="@allNames" TextField="@(( item ) => item)"
                                          ValueField="@(( item ) => item)" @bind-SelectedValue="@p.Name" @bind-SelectedText="@p.UnknownName"
                                          Placeholder="Search roster…" Filter="AutocompleteFilter.StartsWith" FreeTyping
                                          CustomFilter="@(( item, searchValue ) => item.IndexOf( searchValue, 0, StringComparison.CurrentCultureIgnoreCase ) >= 0 )">
                                <NotFoundContent>No roster match for “@context”. Mark this PAX as an FNG or choose another name.</NotFoundContent>
                            </Autocomplete>
                        }
                    </TableRowCell>
                    <TableRowCell>
                        <Check TValue="bool" Checked="@p.IsQ" CheckedChanged="@(isChecked => OnQSelected(p, (bool)isChecked))">
                        </Check>
                    </TableRowCell>
                    <TableRowCell>
                        <Check TValue="bool" Checked="@p.IsFng" CheckedChanged="@(isChecked => OnFngSelected(p, (bool)isChecked))"></Check>
                    </TableRowCell>
                    @if (RegionInfo.HasExtraActivity)
                    {
                        <TableRowCell>
                            <Check TValue="bool" @bind-Checked="@p.ExtraActivity"></Check>
                        </TableRowCell>
                    }
                    <TableRowCell>
                        <button type="button" class="remove-pax" @onclick="@(() => OnRemovePax(p))" aria-label="Remove @(string.IsNullOrWhiteSpace(p.Name) ? p.UnknownName : p.Name)" title="Remove PAX"><Icon Name="IconName.Times" /></button>
                    </TableRowCell>
                </TableRow>
            }
        </TableBody>
        </Table>
        </div>

        <div class="review-footer">
            <Button Color="Color.Secondary" Outline Clicked="@OnAddRowClicked" Disabled="@isLoading">Add PAX</Button>
            <div class="upload-summary">
            @{
                var qList = pax.Where(x => x.IsQ).Select(x => x.Name).ToList();
                var qNames = qList.Any() ? string.Join(", ", qList) : "";
            }
            <span>@pax.Count PAX @(qNames.Length > 0 ? $"· Q’d by {qNames}" : "· Select a Q") @(string.IsNullOrWhiteSpace(ao) ? "" : $"· {ao}")</span>
            @if (isQSource)
            {
                <span class="qs-badge">QS</span>
            }
            </div>
            <Button Color="Color.Primary" Clicked="@OnUploadButtonClicked" Disabled="@isLoading" Loading="isLoading">Upload to Sheets <span aria-hidden="true">→</span></Button>
        </div>
    </section>
}

<Alert Color="Color.Success" @bind-Visible="@showCompleteAlert" Class="upload-success">
    <AlertMessage>
        Upload complete
    </AlertMessage>
    <AlertDescription>
        Attendance was added to Google Sheets.
    </AlertDescription>
    <CloseButton />
</Alert>

</div>
