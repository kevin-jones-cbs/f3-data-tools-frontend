@using F3Core
@using F3Core.Regions
@using F3Wasm.Data
@using F3Wasm.Models

<div class="posted-with-heading">
    <div>
        <h2 class="pax-details-panel-title">@ModeTitle</h2>
        <p class="pax-details-panel-subtitle">@ModeDescription</p>
    </div>
</div>

<div class="posted-with-controls">
    <div class="posted-with-modes" role="tablist" aria-label="Relationship">
        <button type="button" role="tab" class="posted-with-mode @(mode == Mode.PostedWith ? "active" : null)" aria-selected="@(mode == Mode.PostedWith)" @onclick="() => SetMode(Mode.PostedWith)">Posted with</button>
        <button type="button" role="tab" class="posted-with-mode @(mode == Mode.QdBy ? "active" : null)" aria-selected="@(mode == Mode.QdBy)" @onclick="() => SetMode(Mode.QdBy)">Q'd by</button>
        <button type="button" role="tab" class="posted-with-mode @(mode == Mode.QdFor ? "active" : null)" aria-selected="@(mode == Mode.QdFor)" @onclick="() => SetMode(Mode.QdFor)">Q'd for</button>
    </div>

    @if (mode == Mode.PostedWith && rangeOptions.Count > 1)
    {
        <label class="posted-with-range">
            <span class="sr-only">Post range</span>
            <select value="@selectedRange" @onchange="OnRangeChanged">
                @foreach (var option in rangeOptions)
                {
                    <option value="@option.Key">@option.Label</option>
                }
            </select>
        </label>
    }
</div>

@if (loading)
{
    <div class="posted-with-loading"><SpinKit Type="SpinKitType.Bounce" /></div>
}
else if (results.Count == 0)
{
    <p class="posted-with-empty">No one to show for this selection.</p>
}
else
{
    <p class="posted-with-summary">Top @results.Count of @totalMatched.ToString("N0") PAX</p>
    <ol class="posted-with-list">
        @{ var rank = 0; }
        @foreach (var item in results)
        {
            rank++;
            <li>
                <span class="posted-with-rank">@rank</span>
                <span class="posted-with-name">@item.Key</span>
                <span class="posted-with-count">
                    <span class="posted-with-track"><span class="posted-with-bar" style="width: @BarWidth(item.Value)"></span></span>
                    <span class="posted-with-value">@item.Value</span>
                </span>
            </li>
        }
    </ol>
}

@code {
    [Parameter]
    public List<Post> AllPosts { get; set; } = new();
    [Parameter]
    public Region RegionInfo { get; set; }
    [Parameter]
    public List<Post> SelectedPaxPosts { get; set; } = new();
    [Parameter]
    public HistoricalData SelectedPaxHistoricalData { get; set; }

    private enum Mode { PostedWith, QdBy, QdFor }

    private const int ResultLimit = 15;

    private Mode mode = Mode.PostedWith;
    private string selectedRange = "all";
    private bool loading;
    private List<KeyValuePair<string, int>> results = new();
    private int totalMatched;
    private int maxCount;
    private List<(string Key, string Label)> rangeOptions = new();
    private Dictionary<(DateTime Date, string Site), List<Post>> postsByWorkout;
    private List<Post> paxPostsAsc = new();

    private string ModeTitle => mode switch
    {
        Mode.QdBy => "Q'd by",
        Mode.QdFor => "Q'd for",
        _ => "Posted with"
    };

    private string ModeDescription => mode switch
    {
        Mode.QdBy => "Qs who led workouts this PAX attended.",
        Mode.QdFor => "PAX who posted at workouts this PAX led.",
        _ => "PAX who were at the same workouts."
    };

    protected override async Task OnInitializedAsync()
    {
        paxPostsAsc = SelectedPaxPosts.OrderBy(p => p.Date).ToList();
        BuildRangeOptions();
        await LoadAsync();
    }

    private void BuildRangeOptions()
    {
        rangeOptions = new List<(string, string)>();

        var historicalCount = SelectedPaxHistoricalData?.PostCount ?? 0;
        var allTimeLabel = SelectedPaxHistoricalData == null
            ? "All time"
            : $"Since {AllPosts.Min(x => x.Date):M/d/yy}";
        rangeOptions.Add(("all", allTimeLabel));

        var count = paxPostsAsc.Count;
        if (count > 100)
        {
            rangeOptions.Add(("recent", "Last 100 posts"));
        }

        for (var i = 0; i * 100 < count; i++)
        {
            var start = historicalCount + i * 100 + 1;
            var end = historicalCount + Math.Min((i + 1) * 100, count);
            if (end - start < 1) break;
            rangeOptions.Add((i.ToString(), $"Posts {start}–{end}"));
        }
    }

    private async Task SetMode(Mode newMode)
    {
        if (mode == newMode) return;
        mode = newMode;
        await LoadAsync();
    }

    private async Task OnRangeChanged(ChangeEventArgs e)
    {
        selectedRange = e.Value?.ToString() ?? "all";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        await Task.Delay(1);

        EnsureLookup();

        IEnumerable<Post> source = mode switch
        {
            Mode.QdFor => paxPostsAsc.Where(p => p.IsQ),
            Mode.QdBy => paxPostsAsc,
            _ => ApplyRange(paxPostsAsc)
        };

        var counts = new Dictionary<string, int>();
        foreach (var paxPost in source)
        {
            if (!postsByWorkout.TryGetValue((paxPost.Date, paxPost.Site), out var others))
                continue;

            foreach (var other in others)
            {
                if (other.Pax == paxPost.Pax) continue;
                if (mode == Mode.QdBy && !other.IsQ) continue;

                counts[other.Pax] = counts.TryGetValue(other.Pax, out var c) ? c + 1 : 1;
            }
        }

        totalMatched = counts.Count;
        results = counts.OrderByDescending(p => p.Value).ThenBy(p => p.Key).Take(ResultLimit).ToList();
        maxCount = results.Count == 0 ? 1 : results[0].Value;

        loading = false;
    }

    private IEnumerable<Post> ApplyRange(List<Post> posts)
    {
        if (selectedRange == "all") return posts;
        if (selectedRange == "recent") return posts.Skip(Math.Max(0, posts.Count - 100));
        if (int.TryParse(selectedRange, out var index)) return posts.Skip(index * 100).Take(100);
        return posts;
    }

    private void EnsureLookup()
    {
        if (postsByWorkout != null) return;

        postsByWorkout = new Dictionary<(DateTime, string), List<Post>>();
        foreach (var post in AllPosts)
        {
            var key = (post.Date, post.Site);
            if (!postsByWorkout.TryGetValue(key, out var list))
            {
                list = new List<Post>();
                postsByWorkout[key] = list;
            }
            list.Add(post);
        }
    }

    private string BarWidth(int count) => $"{Math.Round((double)count / maxCount * 100, 1)}%";
}
