@using F3Core.Regions
@using F3Core
@using F3Wasm.Models

<div class="pax-stats" aria-label="Summary">
    <div class="pax-stat">
        <span class="pax-stat-label">Posts</span>
        <span class="pax-stat-value">@TotalPosts.ToString("N0")</span>
        <span class="pax-stat-note">@PostPercent.ToString("0")% post rate@(SelectedPaxHistoricalData != null ? " *" : "")</span>
    </div>
    <div class="pax-stat">
        <span class="pax-stat-label">Qs</span>
        <span class="pax-stat-value">@TotalQs.ToString("N0")</span>
        <span class="pax-stat-note">@QPercent.ToString("0")% of posts</span>
    </div>
    <div class="pax-stat">
        <span class="pax-stat-label">First post</span>
        <span class="pax-stat-value pax-stat-value-date">@FirstPostDate.ToString("M/d/yy")</span>
        <span class="pax-stat-note">@TenureText</span>
    </div>
    <div class="pax-stat">
        <span class="pax-stat-label">Best streak@(SelectedPaxHistoricalData != null ? " *" : "")</span>
        <span class="pax-stat-value">@selectedPaxStreak</span>
        <span class="pax-stat-note">@(selectedPaxStreak > 0 ? $"Started {selectedPaxStreakStart:M/d/yy}" : "No streak yet")</span>
    </div>
</div>

<dl class="pax-facts">
    <div>
        <dt>Last post</dt>
        <dd>@LastPostDate.ToString("M/d/yy") <span class="pax-facts-muted">· @DaysSinceText</span></dd>
    </div>
    @if (SelectedPaxHistoricalData == null)
    {
        <div>
            <dt>VQ</dt>
            <dd>@(FirstQDate?.ToString("M/d/yy") ?? "Not yet")</dd>
        </div>
        @if (!string.IsNullOrEmpty(NamedBy))
        {
            <div>
                <dt>Named by</dt>
                <dd>@NamedBy</dd>
            </div>
        }
        <div>
            <dt>Days to 100</dt>
            <dd>@GetCalDaysTo100()</dd>
        </div>
    }
</dl>

@code {
    [Parameter]
    public Region RegionInfo { get; set; }
    [Parameter]
    public List<Post> SelectedPaxPosts { get; set; } = new();
    [Parameter]
    public List<Post> AllPosts { get; set; } = new();
    [Parameter]
    public List<WorkoutDay> AllPossibleWorkoutDays { get; set; } = new();
    [Parameter]
    public HistoricalData SelectedPaxHistoricalData { get; set; }

    private int selectedPaxStreak;
    private DateTime selectedPaxStreakStart;
    private string NamedBy;

    private int TotalPosts => SelectedPaxPosts.Count + (SelectedPaxHistoricalData?.PostCount ?? 0);
    private int TotalQs => SelectedPaxPosts.Count(x => x.IsQ) + (SelectedPaxHistoricalData?.QCount ?? 0);
    private double PostPercent => SelectedPaxPosts.Count == 0 ? 0 : (double)SelectedPaxPosts.Count / Math.Max(1, GetSelectedPaxPossibleCount()) * 100;
    private double QPercent => TotalPosts == 0 ? 0 : (double)TotalQs / TotalPosts * 100;
    private DateTime FirstPostDate => SelectedPaxHistoricalData?.FirstPost ?? SelectedPaxPosts.Min(x => x.Date);
    private DateTime LastPostDate => SelectedPaxPosts.Max(x => x.Date);
    private DateTime? FirstQDate => SelectedPaxPosts.Where(x => x.IsQ).OrderBy(x => x.Date).FirstOrDefault()?.Date;

    private string TenureText
    {
        get
        {
            var days = (DateTime.Today - FirstPostDate.Date).Days;
            if (days < 60) return $"{days} days in";
            if (days < 730) return $"{Math.Round(days / 30.4)} months in";
            return $"{days / 365.0:0.#} years in";
        }
    }

    private string DaysSinceText
    {
        get
        {
            var days = (DateTime.Today - LastPostDate.Date).Days;
            return days switch
            {
                0 => "today",
                1 => "yesterday",
                _ => $"{days} days ago"
            };
        }
    }

    protected override void OnInitialized()
    {
        var paxPostsAsc = SelectedPaxPosts.OrderBy(p => p.Date).ToList();
        (selectedPaxStreak, selectedPaxStreakStart) = StreakHelpers.CalculateStreak(paxPostsAsc, RegionInfo, AllPossibleWorkoutDays);
        NamedBy = GetNamedBy();
    }

    private double GetSelectedPaxPossibleCount()
    {
        var firstPost = SelectedPaxPosts.OrderBy(x => x.Date).FirstOrDefault();
        if (firstPost == null) return 0;
        return AllPossibleWorkoutDays.Count(x => x.Date >= firstPost.Date);
    }

    public string GetNamedBy()
    {
        var paxFirstPost = SelectedPaxPosts.OrderBy(x => x.Date).FirstOrDefault();
        if (paxFirstPost == null)
            return "";

        var namedBy = AllPosts.FirstOrDefault(p => p.Site == paxFirstPost.Site && p.IsQ && p.Date == paxFirstPost.Date);

        return namedBy?.Pax ?? "";
    }

    public string GetCalDaysTo100()
    {
        var sorted = SelectedPaxPosts.OrderBy(x => x.Date).ToList();
        var pax100thPost = sorted.Skip(99).FirstOrDefault();
        var notYet = pax100thPost == null;
        var endDate = pax100thPost?.Date ?? DateTime.Now;
        var pax1stPost = sorted.FirstOrDefault();
        if (pax1stPost == null) return "";

        var days = (endDate - pax1stPost.Date).Days;
        return days.ToString() + (notYet ? " so far" : "");
    }
}
